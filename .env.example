# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local al repositorio.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CRON_SECRET=
# Solo servidor (Supabase → Settings → API Keys → Secret). Nunca como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC para los límites de intentos. Genera uno: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SECRET=
TEMP_PASSWORD_TTL_HOURS=72

# Administradores iniciales (scripts/seed-admins.mjs). Contraseña inicial opcional: si falta, se genera una temporal.
# SOLO LOCAL: estas variables ADMIN* nunca se suben al repositorio ni a Vercel.
ADMIN1_EMAIL=
ADMIN1_NAME=
ADMIN1_INITIAL_PASSWORD=
ADMIN2_EMAIL=
ADMIN2_NAME=
ADMIN2_INITIAL_PASSWORD=

# Correo saliente (recuperación y confirmación) desde la cuenta oficial. Gmail: contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KIIN <kiin.colab@gmail.com>"
